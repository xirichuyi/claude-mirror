<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<OutputType>WinExe</OutputType><TargetFramework>net9.0-windows10.0.19041.0</TargetFramework><TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
<UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained>
<RuntimeIdentifier>win-x64</RuntimeIdentifier><Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
<AssemblyName>claude-mirror</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
</PropertyGroup>
<ItemGroup><PackageReference Include="Markdig" Version="0.41.3" /><PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" /><ProjectReference Include="..\ClaudeMirror.Core\ClaudeMirror.Core.csproj" /></ItemGroup>
<ItemGroup><Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" /><Content Include="..\Resources\server\**\*" Link="server\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
<!-- The unpackaged SDK builds the app resource index and compiled XAML but
     does not always include them in the portable publish directory. -->
<Target Name="PublishWindowResources" AfterTargets="Publish">
  <ItemGroup>
    <WindowResource Include="$(TargetDir)$(AssemblyName).pri;$(TargetDir)App.xbf" />
  </ItemGroup>
  <Copy SourceFiles="@(WindowResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
</Target>
</Project>
