import type { ChatSession, ConnectionConfig, Preferences } from './contracts.js';
import { contextBridge, ipcRenderer, webUtils } from 'electron';
const invoke = <T = any,>(channel: string, ...args: unknown[]): Promise<T> => ipcRenderer.invoke(channel, ...args);
const bridge = {
  setEditorDirty: (value: boolean) => invoke('editor:dirty', value),
  discoverHistory: (config, offset) => invoke('history:discover', config, offset),
  loadHistory: (id: string, older) => invoke('history:load', id, older),
  load: (id: string) => invoke<ChatSession>('chats:load', id),
  list: () => invoke<ChatSession[]>('chats:list'), create: (input: ConnectionConfig) => invoke<ChatSession>('chats:create', input),
  remove: (id: string) => invoke('chats:remove', id), rename: (id: string, name: string) => invoke('chats:rename', id, name),
  send: (id: string, text: string, attachments: any[] = []) => invoke('chat:send', id, text, attachments),
  organize: (id: string, patch) => invoke('chats:organize', id, patch),
  cancelQueued: (id: string, itemId) => invoke('chat:cancel-queued', id, itemId),
  resumeQueue: (id: string) => invoke('chat:resume-queue', id),
  stop: (id: string) => invoke('chat:stop', id),
  capabilities: (id: string, refresh?: boolean) => invoke('chat:capabilities', id, refresh),
  commandInteraction: (id: string, text) => invoke('chat:interaction', id, text),
  selectEffort: (id: string, value: string) => invoke('chat:effort', id, value),
  selectModel: (id: string, model: string) => invoke('chat:model', id, model),
  configure: (id: string, patch: Preferences) => invoke('chat:configure', id, patch),
  details: (id: string, section) => invoke('chat:details', id, section),
  fork: (id: string) => invoke('chat:fork', id),
  exportChat: (id: string) => invoke('chat:export', id),
  respond: (id: string, requestId, answer) => invoke('chat:respond', id, requestId, answer),
  connect: (input: ConnectionConfig) => invoke('ssh:connect', input), disconnect: (input: ConnectionConfig) => invoke('ssh:disconnect', input),
  tunnels: (id: string) => invoke('ssh:tunnels', id),
  forward: (id: string, localPort, remotePort, remove?: boolean) => invoke('ssh:forward', id, localPort, remotePort, remove),
  connectionState: input => invoke('ssh:state', input),
  listFiles: (id: string, folder, hidden, force) => invoke('files:list', id, folder, hidden, force),
  listDirectory: (id: string, folder, hidden, force) => invoke('files:list-dir', id, folder, hidden, force),
  refreshFile: (id: string, file) => invoke('files:refresh', id, file),
  watchDirectories: (id: string, directories) => invoke('files:watch', id, directories),
  searchFiles: (id: string, query) => invoke('files:search', id, query),
  gitStatus: (id: string) => invoke('files:git-status', id),
  gitFileDiff: (id: string, file) => invoke('files:git-diff', id, file),
  createEntry: (id: string, directory, name, folder) => invoke('files:create', id, directory, name, folder),
  renameEntry: (id: string, file, name) => invoke('files:rename', id, file, name),
  removeEntry: (id: string, file, recursive) => invoke('files:remove', id, file, recursive),
  onFilesChanged: callback => ipcRenderer.on('files:changed', (_event, data) => callback(data)),
  saveFile: (id: string, file, text, revision) => invoke('files:save', id, file, text, revision),
  gitDiff: (id: string) => invoke('files:diff', id),
  cancelFiles: kind => invoke('files:cancel', kind),
  preview: (id: string, file) => invoke('files:preview', id, file),
  attach: (id: string, file) => invoke('files:attach', id, file),
  uploadDropped: (id: string, files) => invoke('files:drop', id, files.map(file => webUtils.getPathForFile(file))),
  pasteImage: (id: string, bytes) => invoke('files:paste-image', id, bytes),
  suggestFiles: (id: string, query) => invoke('files:suggest', id, query),
  upload: (id: string, folder) => invoke('files:upload', id, folder),
  download: (id: string, file) => invoke('files:download', id, file),
  openFile: (id: string, file) => invoke('files:open', id, file),
  setWorkspace: (id: string, directory) => invoke('workspace:set', id, directory),
  openLink: (url: string) => invoke('link:open', url),
  onChanged: callback => ipcRenderer.on('chat:changed', (_event, data) => callback(data)),
  onRecoveryError: callback => ipcRenderer.on('ssh:recovery-error', (_event, message) => callback(message)),
  onConnection: callback => ipcRenderer.on('ssh:state', (_event, data) => callback(data)),
  onProgress: callback => ipcRenderer.on('files:progress', (_event, data) => callback(data)),
};
contextBridge.exposeInMainWorld('remoteCC', bridge);
export type RemoteCC = typeof bridge;
