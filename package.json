{
  "name": "remotecc",
  "version": "0.14.0",
  "description": "SSH workspace and chat client for remote Claude Code",
  "main": "build/src/main.cjs",
  "author": "RemoteCC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test build/test/*.test.cjs",
    "test:e2e": "npm run build && node --test build/test/*.e2e.cjs",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --mac dir",
    "build": "tsc -p tsconfig.bootstrap.json && node build/scripts/build.cjs",
    "typecheck": "tsc -p tsconfig.type-tests.json",
    "prestart": "npm run build",
    "pretest": "npm run typecheck && npm run build",
    "prepack": "npm run build",
    "prepare-server": "node build/macos/scripts/prepare-server.cjs",
    "preprepare-server": "npm run build",
    "setup-claude-user": "node build/scripts/setup-claude-user.cjs",
    "presetup-claude-user": "npm run build"
  },
  "build": {
    "appId": "local.remotecc.desktop",
    "productName": "RemoteCC",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/src/**/*",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-darwin-*/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@highlightjs/cdn-assets": "^11.11.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
