{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "legacy",
    "outDir": "build",
    "rootDir": ".",
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/**/*.cts",
    "src/**/*.ts",
    "scripts/**/*.cts",
    "test/**/*.cts",
    "macos/scripts/**/*.cts"
  ]
}
